        <offset>0</offset>
    </actionCalls>
    <apiVersion>64.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <description>Counts records to ensure that it does not exceed the max of 10 to stay within API rate limit.</description>
        <name>Count_Records_for_Validation</name>
        <label>Count Records for Validation</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>recordCount</assignToReference>
            <operator>AssignCount</operator>
            <value>
                <elementReference>ids</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Record_Count_Validation</targetReference>
        </connector>
    </assignments>
    <constants>
        <description>No more than 10 records should be processed at a time to stay within API rate limits.</description>
        <name>recordLimit</name>
        <dataType>Number</dataType>
        <value>
            <numberValue>10.0</numberValue>
        </value>
    </constants>
    <customProperties>
        <name>ScreenProgressIndicator</name>
        <value>
            <stringValue>{&quot;location&quot;:&quot;top&quot;,&quot;type&quot;:&quot;simple&quot;}</stringValue>
        </value>
    </customProperties>
    <decisions>
        <name>Record_Count_Validation</name>
        <label>Record Count Validation</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Record_Limit_Screen</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Record count more than 10</defaultConnectorLabel>
        <rules>
            <name>Record_count_less_than_or_equal_to_10</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>recordCount</leftValueReference>
                <operator>LessThanOrEqualTo</operator>
                <rightValue>
                    <elementReference>recordLimit</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Geocode_Accounts</targetReference>
            </connector>
            <label>Record count less than or equal to 10</label>
        </rules>
    </decisions>
    <environments>Default</environments>
